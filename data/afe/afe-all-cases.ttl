# Five coins of the AFE as sent by Karsten Tolle (package version 3). One change on 2026-11-05, at his request: the class of 16048
# is fw:UncertainResourceValue (was fw:UncertainValue), because the value is a resource.
@prefix afe: <http://afe.dainst.org/coin?afeid=> .
@prefix nfdi_fw: <http://w3id.org/fw_ontology/> .
@prefix nm: <http://nomisma.org/id/> .
@prefix nmo: <http://nomisma.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

afe:12324 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a nfdi_fw:FuzzinessWobblinessResourceValue,
                skos:Collection ;
            skos:member [ nfdi_fw:hasConfidence 0.25 ;
                    rdf:value nm:commodus ],
                [ nfdi_fw:hasConfidence 0.25 ;
                    rdf:value nm:lucius_verus ],
                [ nfdi_fw:hasConfidence 0.25 ;
                    rdf:value nm:marcus_aurelius ] ] .

afe:15661 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a nfdi_fw:VagueResourceValue,
                skos:Collection ;
            skos:member [ nfdi_fw:hasConfidence 0.5 ;
                    rdf:value nm:vespasian ],
                [ nfdi_fw:hasConfidence 0.5 ;
                    rdf:value nm:titus ] ] .

afe:15668 a nmo:NumismaticObject ;
    nmo:hasAuthority nm:aurelian .

afe:11471 a nmo:NumismaticObject ;
    nmo:hasAuthority nm:uncertain_value .


afe:16048 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a nfdi_fw:UncertainResourceValue ;
            nfdi_fw:hasConfidence 0.6 ;
            rdf:value nm:philip_the_arab ] .
