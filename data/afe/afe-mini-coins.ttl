# The four coins of the Mini round trip, one for each kind of statement (certain, uncertain, vague, vague and uncertain).
# Taken from afe-all-cases.ttl (Karsten Tolle, AFE); no change.
@prefix afe: <http://afe.dainst.org/coin?afeid=> .
@prefix fw: <http://w3id.org/fw_ontology/> .
@prefix nm: <http://nomisma.org/id/> .
@prefix nmo: <http://nomisma.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

afe:12324 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a fw:FuzzinessWobblinessResourceValue,
                skos:Collection ;
            skos:member [ fw:hasConfidence 0.25 ;
                    rdf:value nm:commodus ],
                [ fw:hasConfidence 0.25 ;
                    rdf:value nm:marcus_aurelius ],
                [ fw:hasConfidence 0.25 ;
                    rdf:value nm:lucius_verus ] ] .

afe:15661 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a fw:VagueResourceValue,
                skos:Collection ;
            skos:member [ fw:hasConfidence 0.5 ;
                    rdf:value nm:vespasian ],
                [ fw:hasConfidence 0.5 ;
                    rdf:value nm:titus ] ] .

afe:15668 a nmo:NumismaticObject ;
    nmo:hasAuthority nm:aurelian .

afe:16048 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a fw:UncertainResourceValue ;
            fw:hasConfidence 0.6 ;
            rdf:value nm:philip_the_arab ] .

