@prefix amt:  <http://academic-meta-tool.xyz/vocab#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sam: <http://example.org/samian-amt/> .

# =============================================================================
# Toy chain: one abstract individual per concept (no real cases)
# =============================================================================
#
# Only here to show what the reasoning does. The weights are arbitrary
# placeholders chosen to be distinguishable; they are asserted in the
# direction of the source data only (hasType, hasProductionCentre, worksAt).
# Everything else in the output is derived.

sam:Potform_1  amt:instanceOf sam:Potform ;            rdfs:label "Potform 1" .
sam:Carrier_1  amt:instanceOf sam:InformationCarrier ; rdfs:label "Carrier 1" .
sam:Centre_1   amt:instanceOf sam:ProductionCentre ;   rdfs:label "Centre 1" .
sam:Actor_1    amt:instanceOf sam:Actor ;              rdfs:label "Actor 1" .

_:e1 rdf:subject sam:Carrier_1 ; rdf:predicate sam:hasType             ; rdf:object sam:Potform_1 ; amt:weight 0.9 .
_:e2 rdf:subject sam:Carrier_1 ; rdf:predicate sam:hasProductionCentre ; rdf:object sam:Centre_1  ; amt:weight 0.6 .
_:e3 rdf:subject sam:Actor_1   ; rdf:predicate sam:worksAt             ; rdf:object sam:Centre_1  ; amt:weight 0.8 .
