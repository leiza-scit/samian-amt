@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@prefix fw: <http://w3id.org/fw_ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sam: <http://example.org/samian-amt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sam:InformationCarrier a amt:Concept ;
    rdfs:label "Information carrier" .

sam:ic_103585 rdfs:label "Carrier 103585" ;
    amt:instanceOf sam:InformationCarrier .

sam:pf_18_31 rdfs:label "Potform 18/31" .

[] fw:hasDegreeOfConnection 0.5 ;
    fw:hasType fw:Uncertainty ;
    rdf:object sam:pf_18_31 ;
    rdf:predicate sam:hasType ;
    rdf:subject sam:ic_103585 .

