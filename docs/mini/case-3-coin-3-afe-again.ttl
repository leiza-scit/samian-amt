@prefix afe: <http://afe.dainst.org/coin?afeid=> .
@prefix fw: <http://w3id.org/fw_ontology/> .
@prefix nm: <http://nomisma.org/id/> .
@prefix nmo: <http://nomisma.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

afe:15661 a nmo:NumismaticObject ;
    nmo:hasAuthority [ a fw:VagueResourceValue,
                skos:Collection ;
            skos:member [ fw:hasConfidence 0.5 ;
                    rdf:value nm:vespasian ],
                [ fw:hasConfidence 0.5 ;
                    rdf:value nm:titus ] ] .

