@prefix amt:  <http://academic-meta-tool.xyz/vocab#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sam: <http://example.org/samian-amt/> .

# =============================================================================
# samian-amt domain model: Potform -- InformationCarrier -- ProductionCentre -- Actor
# =============================================================================
#
# A deliberately small AMT domain model (AMT vocabulary: Concepts, Roles,
# Axioms). It contains no instances; see data/toy-chain.ttl for an abstract
# demonstration chain.
#
# Every role carries two annotations that the documentation is generated from:
#   skos:definition  what the role says
#   skos:scopeNote   what it does NOT say (the limit that matters archaeologically)
#
# Placeholders, to be replaced later:
#   - the namespace sam: (http://example.org/samian-amt/) is not a real IRI;
#   - the logic operator of the three role chains is amt:ProductLogic, as in
#     the role-chain axioms of the source paper (Thiery et al. 2021, listings
#     5 and 6). It is a proposal: changing it only needs a change of the
#     amt:logic triples below (see the Review page, question 9);
#   - the role names are proposals, except hasType / isTypeOf (agreed with
#     Allard Mees for the Potform case).
#
# Reading guide
#   chain direction   Potform  ->  InformationCarrier  ->  ProductionCentre  ->  Actor
#   asserted roles    follow the source model (the three lado:hasAMT links):
#                     InformationCarrier -> Potform, InformationCarrier ->
#                     ProductionCentre, Actor -> ProductionCentre
#   inverse roles     are needed because two of the three asserted roles point
#                     against the chain direction; AMT chains compose edges
#                     head-to-tail, so without inverses nothing composes
#   derived roles     (">>") are produced by role chains. They have inverses
#                     ("<<") so that every association can be read from both
#                     ends, and are subsumed by the generic role sam:reaches
#   weights           an inverse edge carries the same amt:weight as its
#                     antecedent (see the "Weights" page of the documentation)
# =============================================================================

<http://example.org/samian-amt> a owl:Ontology ;
    rdfs:label "samian-amt domain model"@en ;
    rdfs:comment "Potform - InformationCarrier - ProductionCentre - Actor, with inverse roles and role-chain reasoning."@en .


# ── 1. Concepts ──────────────────────────────────────────────────────────────

sam:Potform a amt:Concept ;
    rdfs:label "Potform" ;
    amt:placeholder "Potform" ;
    rdfs:comment "Vessel form or type (the typological class of an information carrier)."@en .

sam:InformationCarrier a amt:Concept ;
    rdfs:label "InformationCarrier" ;
    amt:placeholder "Information carrier" ;
    rdfs:comment "The object carrying the information (e.g. a stamped vessel or sherd)."@en .

sam:ProductionCentre a amt:Concept ;
    rdfs:label "ProductionCentre" ;
    amt:placeholder "Production centre" ;
    rdfs:comment "Place of production (e.g. a kiln site)."@en .

sam:Actor a amt:Concept ;
    rdfs:label "Actor" ;
    amt:placeholder "Actor" ;
    rdfs:comment "Person working at a production centre (the source model's ActorEntity and Actor are collapsed here)."@en .


sam:Entity a amt:Concept ;
    rdfs:label "Entity" ;
    amt:placeholder "Entity" ;
    rdfs:comment "Helper concept: any of the four concepts above. It is used only as domain and range of the generic roles reaches and reachedBy, which span several concept pairs; no individual is declared an instance of it."@en .


# ── 2. Roles: asserted (direction of the source data) ───────────────────────

sam:hasType a amt:Role ;
    rdfs:label "hasType" ;
    rdfs:domain sam:InformationCarrier ;
    rdfs:range  sam:Potform ;
    skos:definition "The information carrier is of this potform."@en ;
    skos:scopeNote  "A classification of the carrier. It does not say where the potform was produced."@en .

sam:hasProductionCentre a amt:Role ;
    rdfs:label "hasProductionCentre" ;
    rdfs:domain sam:InformationCarrier ;
    rdfs:range  sam:ProductionCentre ;
    skos:definition "The information carrier is attributed to this production centre, i.e. it is assumed to have been produced there."@en ;
    skos:scopeNote  "An attribution, not a proof. Its weight is the degree to which the attribution holds."@en .

sam:worksAt a amt:Role ;
    rdfs:label "worksAt" ;
    rdfs:domain sam:Actor ;
    rdfs:range  sam:ProductionCentre ;
    skos:definition "The actor worked at this production centre."@en ;
    skos:scopeNote  "Says nothing about when. The period in which the actor was active is not part of the role."@en .


# ── 3. Roles: inverses of the asserted roles ────────────────────────────────

sam:isTypeOf a amt:Role ;
    rdfs:label "isTypeOf" ;
    rdfs:domain sam:Potform ;
    rdfs:range  sam:InformationCarrier ;
    skos:definition "The potform is the type of this information carrier. Inverse of hasType (agreed with Allard Mees)."@en ;
    skos:scopeNote  "The same statement as hasType, read from the potform: one potform is the type of many carriers."@en .

sam:isProductionCentreOf a amt:Role ;
    rdfs:label "isProductionCentreOf" ;
    rdfs:domain sam:ProductionCentre ;
    rdfs:range  sam:InformationCarrier ;
    skos:definition "The production centre is the attributed place of production of this information carrier. Inverse of hasProductionCentre."@en ;
    skos:scopeNote  "Not used by a role chain; kept so that every role has its inverse."@en .

sam:hasWorker a amt:Role ;
    rdfs:label "hasWorker" ;
    rdfs:domain sam:ProductionCentre ;
    rdfs:range  sam:Actor ;
    skos:definition "This actor worked at the production centre. Inverse of worksAt."@en ;
    skos:scopeNote  "The same statement as worksAt, read from the centre. No time is implied."@en .


# ── 4. Roles: derived (">>") and their inverses ("<<") ──────────────────────
# Each ">>" role is the consequent of a role chain (section 6). Its weight is
# the logic operator applied to the weights of the chain (proposal: product, as in the paper).
# "Associated with" always means: connected through the chain, nothing more.

sam:potformToCentre a amt:Role ;
    rdfs:label "potformToCentre" ;
    rdfs:domain sam:Potform ;
    rdfs:range  sam:ProductionCentre ;
    skos:definition "The potform is associated with the production centre: a carrier of this type is attributed to that centre."@en ;
    skos:scopeNote  "An association through at least one carrier. It does not say that the centre produced all, or most, carriers of the potform."@en .

sam:centreToPotform a amt:Role ;
    rdfs:label "centreToPotform" ;
    rdfs:domain sam:ProductionCentre ;
    rdfs:range  sam:Potform ;
    skos:definition "The production centre is associated with the potform: a carrier attributed to the centre is of this type. Inverse of potformToCentre."@en ;
    skos:scopeNote  "Read from the centre, this is its attested range of forms as far as carriers are attributed to it. It is neither complete nor proportional."@en .

sam:carrierToActor a amt:Role ;
    rdfs:label "carrierToActor" ;
    rdfs:domain sam:InformationCarrier ;
    rdfs:range  sam:Actor ;
    skos:definition "The information carrier is associated with the actor: the carrier is attributed to a centre at which the actor worked."@en ;
    skos:scopeNote  "A shared-centre association, not an attribution of authorship. The time intervals of carrier and actor are not compared."@en .

sam:actorToCarrier a amt:Role ;
    rdfs:label "actorToCarrier" ;
    rdfs:domain sam:Actor ;
    rdfs:range  sam:InformationCarrier ;
    skos:definition "The actor is associated with the information carrier: the actor worked at the centre to which the carrier is attributed. Inverse of carrierToActor."@en ;
    skos:scopeNote  "Candidate carriers of the actor, not carriers the actor is known to have made."@en .

sam:potformToActor a amt:Role ;
    rdfs:label "potformToActor" ;
    rdfs:domain sam:Potform ;
    rdfs:range  sam:Actor ;
    skos:definition "The potform is associated with the actor: a carrier of this type is attributed to a centre at which the actor worked."@en ;
    skos:scopeNote  "The weakest of the three associations: three steps, two of them through the same centre. It does not say that the actor produced this potform."@en .

sam:actorToPotform a amt:Role ;
    rdfs:label "actorToPotform" ;
    rdfs:domain sam:Actor ;
    rdfs:range  sam:Potform ;
    skos:definition "The actor is associated with the potform: the forms attested at the centre where the actor worked. Inverse of potformToActor."@en ;
    skos:scopeNote  "A candidate repertoire of the actor, derived from the centre. It is not the actor's own repertoire."@en .

sam:reaches a amt:Role ;
    rdfs:label "reaches" ;
    rdfs:domain sam:Entity ;
    rdfs:range  sam:Entity ;
    skos:definition "Generic derived role (>>): any of the three derived association roles. One query on it finds all of them."@en ;
    skos:scopeNote  "Spans several concept pairs, so its domain and range are the helper concept Entity (the AMT shapes ask for exactly one of each)."@en .

sam:reachedBy a amt:Role ;
    rdfs:label "reachedBy" ;
    rdfs:domain sam:Entity ;
    rdfs:range  sam:Entity ;
    skos:definition "Generic derived inverse role (<<). Inverse of reaches."@en ;
    skos:scopeNote  "Spans several concept pairs, so its domain and range are the helper concept Entity (the AMT shapes ask for exactly one of each)."@en .


# ── 5. Axioms: inverses ─────────────────────────────────────────────────────
# Declared in the direction of the asserted or derived role. If data ever
# arrives in the other direction, add the reverse axiom. The engine copies the
# weight of the antecedent edge to the inverse edge.

sam:INV_hasType a amt:InverseAxiom ;
    rdfs:label "hasType <-> isTypeOf" ;
    amt:antecedent sam:hasType ;
    amt:inverse    sam:isTypeOf .

sam:INV_hasProductionCentre a amt:InverseAxiom ;
    rdfs:label "hasProductionCentre <-> isProductionCentreOf" ;
    amt:antecedent sam:hasProductionCentre ;
    amt:inverse    sam:isProductionCentreOf .

sam:INV_worksAt a amt:InverseAxiom ;
    rdfs:label "worksAt <-> hasWorker" ;
    amt:antecedent sam:worksAt ;
    amt:inverse    sam:hasWorker .

sam:INV_potformToCentre a amt:InverseAxiom ;
    rdfs:label "potformToCentre <-> centreToPotform" ;
    amt:antecedent sam:potformToCentre ;
    amt:inverse    sam:centreToPotform .

sam:INV_carrierToActor a amt:InverseAxiom ;
    rdfs:label "carrierToActor <-> actorToCarrier" ;
    amt:antecedent sam:carrierToActor ;
    amt:inverse    sam:actorToCarrier .

sam:INV_potformToActor a amt:InverseAxiom ;
    rdfs:label "potformToActor <-> actorToPotform" ;
    amt:antecedent sam:potformToActor ;
    amt:inverse    sam:actorToPotform .

sam:INV_reaches a amt:InverseAxiom ;
    rdfs:label "reaches <-> reachedBy" ;
    amt:antecedent sam:reaches ;
    amt:inverse    sam:reachedBy .


# ── 6. Axioms: role chains (the three ">>" rules) ───────────────────────────
# [Potform]--amt--[InformationCarrier]--amt--[ProductionCentre]   = [Potform]>>[ProductionCentre]
# [InformationCarrier]--amt--[ProductionCentre]--amt--[Actor]     = [InformationCarrier]>>[Actor]
# [Potform]--amt--[InformationCarrier]--amt--[ProductionCentre]--amt--[Actor] = [Potform]>>[Actor]
#
# The third chain is written out over the base roles (n-ary) rather than as
# potformToCentre o hasWorker. For associative operators (Goedel, Product,
# Einstein, Hamacher) both give the same degree; for the n-ary geometric mean
# they do not, so the n-ary form is the one that means what it says.
# amt:logic is amt:ProductLogic in all three.

sam:RCA_potformToCentre a amt:RoleChainAxiom ;
    rdfs:label "isTypeOf o hasProductionCentre -> potformToCentre" ;
    amt:antecedents ( sam:isTypeOf sam:hasProductionCentre ) ;
    amt:consequent  sam:potformToCentre ;
    amt:logic       amt:ProductLogic .

sam:RCA_carrierToActor a amt:RoleChainAxiom ;
    rdfs:label "hasProductionCentre o hasWorker -> carrierToActor" ;
    amt:antecedents ( sam:hasProductionCentre sam:hasWorker ) ;
    amt:consequent  sam:carrierToActor ;
    amt:logic       amt:ProductLogic .

sam:RCA_potformToActor a amt:RoleChainAxiom ;
    rdfs:label "isTypeOf o hasProductionCentre o hasWorker -> potformToActor" ;
    amt:antecedents ( sam:isTypeOf sam:hasProductionCentre sam:hasWorker ) ;
    amt:consequent  sam:potformToActor ;
    amt:logic       amt:ProductLogic .


# ── 7. Axioms: subsumption under the generic ">>" ───────────────────────────

sam:SUB_potformToCentre a amt:SubsumptionAxiom ;
    rdfs:label "potformToCentre subsumed by reaches" ;
    amt:subRole   sam:potformToCentre ;
    amt:superRole sam:reaches .

sam:SUB_carrierToActor a amt:SubsumptionAxiom ;
    rdfs:label "carrierToActor subsumed by reaches" ;
    amt:subRole   sam:carrierToActor ;
    amt:superRole sam:reaches .

sam:SUB_potformToActor a amt:SubsumptionAxiom ;
    rdfs:label "potformToActor subsumed by reaches" ;
    amt:subRole   sam:potformToActor ;
    amt:superRole sam:reaches .
