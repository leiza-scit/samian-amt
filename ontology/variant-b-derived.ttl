@prefix amt:  <http://academic-meta-tool.xyz/vocab#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix sam: <http://example.org/samian-amt/> .

# =============================================================================
# Variant M2: the carrier-centre link is derived, not asserted
# =============================================================================
#
# In the source paper the weighted statements are the potter at a centre
# (approach A) and the carrier with a potform (approach C). That a carrier
# has a vague relation to a centre (approach B) "follows from approach A":
# the stamp names the potter, and the potter worked at the centre.
#
# M2 models exactly that. The carrier-potter link (createdBy) is crisp
# (weight 1.0); hasProductionCentre is not asserted but derived as
# carrierToCentre = createdBy o worksAt. It exists to be compared with the
# main model M1 (ontology/samian-amt.ttl, where hasProductionCentre is asserted
# as in the data export). It reuses the role names hasType, worksAt and
# hasWorker of M1 and carries no documentation annotations.
# =============================================================================

<http://example.org/samian-amt/variant-b-derived> a owl:Ontology ;
    rdfs:label "samian-amt variant M2: carrier-centre derived from the actor"@en .

sam:Potform            a amt:Concept ; rdfs:label "Potform" .
sam:InformationCarrier a amt:Concept ; rdfs:label "InformationCarrier" .
sam:ProductionCentre   a amt:Concept ; rdfs:label "ProductionCentre" .
sam:Actor              a amt:Concept ; rdfs:label "Actor" .

# asserted
sam:hasType   a amt:Role ; rdfs:label "hasType"   ; rdfs:domain sam:InformationCarrier ; rdfs:range sam:Potform .
sam:createdBy a amt:Role ; rdfs:label "createdBy" ; rdfs:domain sam:InformationCarrier ; rdfs:range sam:Actor .
sam:worksAt   a amt:Role ; rdfs:label "worksAt"   ; rdfs:domain sam:Actor ; rdfs:range sam:ProductionCentre .
# inverses
sam:isTypeOf  a amt:Role ; rdfs:label "isTypeOf"  ; rdfs:domain sam:Potform ; rdfs:range sam:InformationCarrier .
sam:creates   a amt:Role ; rdfs:label "creates"   ; rdfs:domain sam:Actor ; rdfs:range sam:InformationCarrier .
sam:hasWorker a amt:Role ; rdfs:label "hasWorker" ; rdfs:domain sam:ProductionCentre ; rdfs:range sam:Actor .
# derived
sam:carrierToCentre  a amt:Role ; rdfs:label "carrierToCentre"  ; rdfs:domain sam:InformationCarrier ; rdfs:range sam:ProductionCentre .
sam:centreToCarrier  a amt:Role ; rdfs:label "centreToCarrier"  ; rdfs:domain sam:ProductionCentre ; rdfs:range sam:InformationCarrier .
sam:potformToActor   a amt:Role ; rdfs:label "potformToActor"   ; rdfs:domain sam:Potform ; rdfs:range sam:Actor .
sam:actorToPotform   a amt:Role ; rdfs:label "actorToPotform"   ; rdfs:domain sam:Actor ; rdfs:range sam:Potform .
sam:potformToCentre  a amt:Role ; rdfs:label "potformToCentre"  ; rdfs:domain sam:Potform ; rdfs:range sam:ProductionCentre .
sam:centreToPotform  a amt:Role ; rdfs:label "centreToPotform"  ; rdfs:domain sam:ProductionCentre ; rdfs:range sam:Potform .

sam:INV_hasType a amt:InverseAxiom ; amt:antecedent sam:hasType ; amt:inverse sam:isTypeOf .
sam:INV_createdBy a amt:InverseAxiom ; amt:antecedent sam:createdBy ; amt:inverse sam:creates .
sam:INV_worksAt a amt:InverseAxiom ; amt:antecedent sam:worksAt ; amt:inverse sam:hasWorker .
sam:INV_carrierToCentre a amt:InverseAxiom ; amt:antecedent sam:carrierToCentre ; amt:inverse sam:centreToCarrier .
sam:INV_potformToActor a amt:InverseAxiom ; amt:antecedent sam:potformToActor ; amt:inverse sam:actorToPotform .
sam:INV_potformToCentre a amt:InverseAxiom ; amt:antecedent sam:potformToCentre ; amt:inverse sam:centreToPotform .

sam:RCA_carrierToCentre a amt:RoleChainAxiom ;
    rdfs:label "createdBy o worksAt -> carrierToCentre" ;
    amt:antecedents ( sam:createdBy sam:worksAt ) ;
    amt:consequent  sam:carrierToCentre ;
    amt:logic       amt:ProductLogic .

sam:RCA_potformToActor a amt:RoleChainAxiom ;
    rdfs:label "isTypeOf o createdBy -> potformToActor" ;
    amt:antecedents ( sam:isTypeOf sam:createdBy ) ;
    amt:consequent  sam:potformToActor ;
    amt:logic       amt:ProductLogic .

sam:RCA_potformToCentre a amt:RoleChainAxiom ;
    rdfs:label "isTypeOf o createdBy o worksAt -> potformToCentre" ;
    amt:antecedents ( sam:isTypeOf sam:createdBy sam:worksAt ) ;
    amt:consequent  sam:potformToCentre ;
    amt:logic       amt:ProductLogic .
